{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    },
    "api/masav.js": {
      "maxDuration": 30
    },
    "api/chat-friend.js": {
      "maxDuration": 30
    },
    "api/room.js": {
      "maxDuration": 35
    },
    "api/anki.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/history",         "destination": "/api/misc?fn=history" },
    { "source": "/api/email-templates", "destination": "/api/misc?fn=email-templates" },
    { "source": "/api/analytics",       "destination": "/api/misc?fn=analytics" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",        "value": "nosniff" },
        { "key": "X-Frame-Options",               "value": "DENY" },
        { "key": "Referrer-Policy",               "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security",     "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy",            "value": "geolocation=(), microphone=(self), camera=(self)" }
      ]
    }
  ]
}
